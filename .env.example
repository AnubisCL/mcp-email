# Email MCP Server 环境变量配置
# 请填写你的 163 邮箱授权码（不是登录密码）

# ==================== 单用户模式配置 ====================
# 当不使用 API Key 时，从环境变量读取邮箱配置
MCP_EMAIL_USERNAME=anubiscl@163.com
MCP_EMAIL_PASSWORD=xxxx

# IMAP 服务器配置
MCP_EMAIL_SERVER=imap.163.com
MCP_EMAIL_PORT=993

# SMTP 服务器配置
MCP_SMTP_SERVER=smtp.163.com
MCP_SMTP_PORT=465

# 附件保存路径
MCP_SAVE_PATH=/Users/anubis/404net/mcp-project/163email-mcp/attachments

# 日志级别: DEBUG, INFO, WARNING, ERROR
MCP_LOG_LEVEL=INFO

# MCP 服务器地址
MCP_HOST=127.0.0.1
MCP_PORT=8001

# ==================== 多用户模式配置API ====================
# 配置管理API服务器地址
CONFIG_API_HOST=127.0.0.1
CONFIG_API_PORT=8002