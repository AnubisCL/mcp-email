# Email MCP Server 环境变量配置
# 此项目仅支持多用户模式（API Key 认证）
# 邮箱配置请通过 Web 界面管理：http://127.0.0.1:8002/config-ui/index.html

# ==================== MCP 服务器配置 ====================
# MCP 服务器监听地址
MCP_HOST=127.0.0.1
MCP_PORT=8001

# 日志级别: DEBUG, INFO, WARNING, ERROR
MCP_LOG_LEVEL=INFO

# ==================== 配置 API 服务器配置 ====================
# 配置管理 API 服务器地址
CONFIG_API_HOST=127.0.0.1
CONFIG_API_PORT=8002
